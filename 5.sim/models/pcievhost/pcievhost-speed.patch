+// openPCIE: on a lane reversal, each lane's running disparity stays with its
+// physical line (SetLaneReverse() in pcie.c); the scrambler is one for all
+// lanes
+void SwapLaneDisparity (const int linkwidth, const int node)
+{
+    for (int l = 0; l < linkwidth / 2; l++)
+    {
+        int rd = this->rd[l];
+        this->rd[l] = this->rd[linkwidth-1-l];
+        this->rd[linkwidth-1-l] = rd;
+    }
