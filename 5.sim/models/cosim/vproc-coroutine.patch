 #include "VProc.h"
 #include "VUser.h"
 
+#ifdef VPROC_COROUTINE
+#include <stdint.h>
+#include <sys/mman.h>
+#endif
+
 // Forward declaration
 static void VUserInit (const unsigned node);
 
+#ifdef VPROC_COROUTINE
+// -------------------------------------------------------------------------
+// openPCIE: the user code as a coroutine (VProc.h, VPROC_COROUTINE)
+//
+// VCoSwap(save, load), x86-64 System V ABI: pushes the callee-saved registers
+// and the SSE/x87 control words, stores the stack pointer in *save, loads
+// 'load' and pops the same from there. A new coroutine's stack starts as if
+// VCoSwap had saved it, returning into VCoStart, which calls r12(r13).
+// -------------------------------------------------------------------------
+
+#define VCO_STACK_BYTES   (16u << 20)   // as a thread's default stack, ample for an ISS
+#define VCO_GUARD_BYTES   4096          // no access: a stack overflow faults at once
+#define VCO_CTL_WORDS     0x037f00001f80ull  // x87 control word 0x037f, MXCSR 0x1f80: the defaults
+
+extern void VCoStart (void) __attribute__((visibility("hidden")));
+
+__asm__ (
+    "    .text\n"
+    "    .p2align 4\n"
+    "    .globl  VCoSwap\n"
+    "    .hidden VCoSwap\n"
+    "    .type   VCoSwap, @function\n"
+    "VCoSwap:\n"
+    "    pushq   %rbp\n"
+    "    pushq   %rbx\n"
+    "    pushq   %r12\n"
+    "    pushq   %r13\n"
+    "    pushq   %r14\n"
+    "    pushq   %r15\n"
+    "    subq    $8, %rsp\n"
+    "    stmxcsr (%rsp)\n"
+    "    fnstcw  4(%rsp)\n"
+    "    movq    %rsp, (%rdi)\n"
+    "    movq    %rsi, %rsp\n"
+    "    ldmxcsr (%rsp)\n"
+    "    fldcw   4(%rsp)\n"
+    "    addq    $8, %rsp\n"
+    "    popq    %r15\n"
+    "    popq    %r14\n"
+    "    popq    %r13\n"
+    "    popq    %r12\n"
+    "    popq    %rbx\n"
+    "    popq    %rbp\n"
+    "    ret\n"
+    "    .size   VCoSwap, .-VCoSwap\n"
+    "    .p2align 4\n"
+    "    .globl  VCoStart\n"
+    "    .hidden VCoStart\n"
+    "    .type   VCoStart, @function\n"
+    "VCoStart:\n"
+    "    .cfi_startproc\n"
+    "    .cfi_undefined rip\n"              // the bottom of the coroutine's stack: backtraces end here
+    "    movq    %r13, %rdi\n"
+    "    callq   *%r12\n"
+    "    ud2\n"
+    "    .cfi_endproc\n"
+    "    .size   VCoStart, .-VCoStart\n"
+);
+
+// The coroutine's body: the user code. Should VUserMain<n>() return, the node
+// idles from then on, instead of the simulator waiting for it forever
+static void VCoEntry (const unsigned node)
+{
+    VUserInit(node);
+
+    VPrint("***Error: VUserMain%d returned; node %d now idles\n", node, node);
+    for (;;)
+    {
+        ns[node]->send_buf.ticks = 0x7fffffff;
+        ns[node]->send_buf.rw    = 0;
+        VCoSwap(&(ns[node]->co_user_sp), ns[node]->co_sim_sp);
+    }
+}
+
+// A stack for 'node' (a guard page below it), laid out as VCoSwap leaves one,
+// so that the first switch to it enters VCoEntry(node)
+static int VCoCreate (const unsigned node)
+{
+    char *mem = mmap(NULL, VCO_STACK_BYTES + VCO_GUARD_BYTES, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK, -1, 0);
+    if (mem == MAP_FAILED || mprotect(mem, VCO_GUARD_BYTES, PROT_NONE))
+    {
+        return 1;
+    }
+
+    uint64_t *sp = (uint64_t *)(((uintptr_t)(mem + VCO_GUARD_BYTES + VCO_STACK_BYTES)) & ~(uintptr_t)15);
+    *--sp = (uint64_t)(uintptr_t)VCoStart;     // VCoSwap returns here; then rsp is 16-byte aligned
+    *--sp = 0;                                 // rbp
+    *--sp = 0;                                 // rbx
+    *--sp = (uint64_t)(uintptr_t)VCoEntry;     // r12: the function
+    *--sp = node;                              // r13: its argument
+    *--sp = 0;                                 // r14
+    *--sp = 0;                                 // r15
+    *--sp = VCO_CTL_WORDS;                     // MXCSR, x87 control word
+    ns[node]->co_user_sp = sp;
+
+    return 0;
+}
+#endif
+
