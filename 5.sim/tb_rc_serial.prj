# xsim source list for the Artix-7 RC model on the serial line (make RC=model
# IFACE=serial, tb_rc_serial.sv): models only, no RTL.

# $BFM: openPCIE_BFM (vip/openPCIE_BFM); $VIP: its VIP build. make fills both in (obj/tb_rc_serial.prj).
sv work $BFM/2.rtl/openPCIE_BFM_pkg.sv
sv work $VIP/hdl/f_mem_model.sv
sv work $VIP/hdl/f_VProc.sv
sv work $VIP/hdl/clkmux.sv
sv work $VIP/hdl/Serialiser.sv
sv work $VIP/hdl/pcieVHost.sv
sv work ../2.rtl/0.common.opensource/src/pcie/link_pkg.sv
sv work tb_rc_serial.sv
